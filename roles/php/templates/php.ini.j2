# Here are the configs for the server anything that needs to be change or adjusted with server settings that would normally require going into the files to change should be here and easy to change to your liking

memory_limit = {{ nextcloud_php_memory_limit }}
upload_max_filesize = {{ nextcloud_upload_max_size }}
post_max_size = {{ nextcloud_upload_max_size }}
date.timezone = {{ php_timezone }}
max_execution_time = 3600
max_input_time = 3600
output_buffering = Off

opcache.enable = 1
opcache.memory_consumption = 256
opcache.interned_strings_buffer = 32
opcache.max_accelerated_files = 10000
opcache.revalidate_freq = 1
opcache.save_comments = 1

apc.enable_cli = 1